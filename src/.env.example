# =============================================================================
# FLEETIQ — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is already in .gitignore.
#
# Usage:
#   cp src/.env.example src/.env
#   # Edit src/.env with your real credentials
# =============================================================================

# -----------------------------------------------------------------------------
# IBM watsonx.ai (required for AI Operational Summary feature)
# Get these from: IBM Cloud → watsonx.ai → your project → Manage → Credentials
# -----------------------------------------------------------------------------
WATSONX_API_KEY=your_ibm_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Configurable Granite model ID — set to any currently supported ibm/ model.
# Default used by the application if this variable is not set:
#   ibm/granite-3-8b-instruct
# Other options (must be available in your watsonx.ai project region):
#   ibm/granite-3-2b-instruct
#   ibm/granite-3-8b-instruct
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_PORT=8000
APP_ENV=development

# -----------------------------------------------------------------------------
# Frontend (used by Vite during development)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
